# ============================================
# Traffic Management System - .gitignore
# ============================================

# ============================================
# Backend (Java/Maven)
# ============================================

# Maven
backend/target/
backend/pom.xml.tag
backend/pom.xml.releaseBackup
backend/pom.xml.versionsBackup
backend/pom.xml.next
backend/release.properties
backend/dependency-reduced-pom.xml
backend/buildNumber.properties
backend/.mvn/timing.properties
backend/.mvn/wrapper/maven-wrapper.jar

# Java
*.class
*.jar
*.war
*.ear
*.log
*.ctxt
.mtj.tmp/
hs_err_pid*

# IDE - IntelliJ
.idea/
*.iws
*.iml
*.ipr
backend/.idea/
backend/*.iml

# IDE - Eclipse
.project
.classpath
.settings/
.metadata
backend/.project
backend/.classpath
backend/.settings/

# IDE - VS Code
.vscode/
backend/.vscode/

# IDE - NetBeans
nbproject/private/
build/
nbbuild/
dist/
nbdist/
.nb-gradle/

# Application properties with sensitive data
backend/src/main/resources/application-local.properties
backend/src/main/resources/application-prod.properties

# ============================================
# Frontend (React/Node)
# ============================================

# Dependencies
frontend/node_modules/
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*

# Testing
frontend/coverage/

# Production build
frontend/build/
frontend/dist/

# Misc
frontend/.DS_Store
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local

# IDE
frontend/.vscode/
frontend/.idea/

# ============================================
# Database
# ============================================

# Database backups
database/backups/
database/*.backup
database/*.bak

# Database credentials
database/credentials.txt
database/.env

# ============================================
# General
# ============================================

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# Logs
*.log
logs/
*.log.*

# Temporary files
*.tmp
*.temp
*~
.*.swp
.*.swo

# Environment variables
.env
.env.local
.env.*.local

# Backup files
*.bak
*.backup
*~

# IDE folder
.vscode/
.idea/

# Build artifacts
build/
dist/
out/

# Documentation temp files
*.pdf~
*.docx~

# Sensitive information
secrets.txt
credentials.txt
config-local.*

# ============================================
# Keep these files (exceptions)
# ============================================

!.gitkeep
!*.example
